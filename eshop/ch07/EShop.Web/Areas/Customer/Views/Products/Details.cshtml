@model Product
@{
    ViewData["Title"] = Model.Name;
}

<h1>@Model.Name</h1>

<dl class="row">
    <dt class="col-sm-2">產地</dt>
    <dd class="col-sm-10">@Model.Origin</dd>
    <dt class="col-sm-2">售價</dt>
    <dd class="col-sm-10">NT$ @Model.Price.ToString("N0")</dd>
    <dt class="col-sm-2">庫存</dt>
    <dd class="col-sm-10">@(Model.InStock ? $"{Model.Stock} 包" : "已售完")</dd>
</dl>

<div class="alert alert-info">
    運費試算：單買一包，@ViewData["ShippingName"] 運費 @ViewData["ShippingFee"] 元
</div>

<a asp-action="Index" class="btn btn-outline-secondary">← 回商品列表</a>
