@model List<CategorySummary>
@{
    ViewData["Title"] = "營運總覽";
}

<h2>營運總覽</h2>
<p>資料庫中共有 <strong>@ViewData["CategoryCount"]</strong> 個分類。</p>

<table class="table table-bordered">
    <thead>
        <tr><th>分類</th><th>款數</th><th>平均價格</th><th>總庫存</th></tr>
    </thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.CategoryName</td>
            <td>@s.ProductCount</td>
            <td>NT$ @s.AveragePrice.ToString("N0")</td>
            <td>@s.TotalStock</td>
        </tr>
    }
    </tbody>
</table>
